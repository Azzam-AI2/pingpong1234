# Salin file ini menjadi .env lalu isi dengan kredensial project Supabase kamu.
# Ambil dari: Supabase Dashboard -> Project Settings -> API
#
# PENTING: hanya pakai "anon public key" (yang memang dirancang untuk dipakai di browser).
# JANGAN pernah menaruh "service_role key" atau secret lain di file ini — semua isi
# variabel VITE_* ikut terkirim ke browser dan bisa dibaca siapa pun.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
